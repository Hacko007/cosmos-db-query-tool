<Window x:Class="CosmosDbQueryTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cosmos DB Query Tool"
        Height="900"
        Width="1440"
        MinHeight="720"
        MinWidth="1100">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16"
                Background="#FF0F172A"
                CornerRadius="8">
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="Cosmos DB Query Tool" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#FFE2E8F0"
                           Text="Open Connections to manage your saved connection tabs, then run a SQL query, inspect the results in the grid, and view the full JSON for the selected row." />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,14,0,14"
                Padding="16"
                BorderBrush="#FFD1D5DB"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Current Connection" />
                        <TextBlock Foreground="#FF64748B"
                                   Margin="0,2,15,0"
                                   Text="The selected tab in the Connections window is the active connection used for queries." />
                    </StackPanel>
                        
                        <Border  Margin="0,0,10,0"
                                 Padding="7,4"
                                 Background="#FFF8FAFC"
                                 CornerRadius="6"
                                 BorderBrush="DarkCyan"
                                 BorderThickness="3"
                                 ToolTip="Open the Connections window to switch tabs, edit connection details, or add new connection profiles.">
                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#FF0F172A"
                                           Text="{Binding CurrentConnectionName}" />
                        </Border>
                        
                    <Button x:Name="OpenConnectionsButton"
                            MaxHeight="35"
                            MinWidth="150"
                            Click="OpenConnectionsButton_OnClick"
                            Content="Open Connections" />
                    </StackPanel>
                </StackPanel>

               
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="16"
                BorderBrush="#FFD1D5DB"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Margin="20,0,0,0">
                    <StackPanel >
                        <TextBlock FontWeight="SemiBold" Text="Recent Queries" />
                        <TextBlock Foreground="#FF64748B"
                                   FontSize="12"
                                   Text="Pick one of the last 50 successful unique queries to reuse it." />
                    </StackPanel>

                    <ComboBox x:Name="RecentQueriesComboBox"
                              Width="460"
                              HorizontalAlignment="Left"
                              Margin="0,15,0,0"
                              Padding="8,4"
                              ItemsSource="{Binding RecentQueries}"
                              SelectionChanged="RecentQueriesComboBox_OnSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Margin="0,0,0,0"
                           FontWeight="SemiBold"
                           Text="Cosmos DB SQL Query" />
                <TextBox x:Name="QueryTextBox"
                         Grid.Row="1"
                         Grid.Column="0"
                         Grid.RowSpan="2"
                         Margin="0,10,0,0"
                         Padding="12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Consolas"
                         FontSize="14"
                         Text='SELECT TOP 25 * FROM c where c.id = ""' />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <Button x:Name="RunQueryButton"
                    Grid.Column="0"
                    MinWidth="140"
                    Padding="16,10"
                    Click="RunQueryButton_OnClick"
                    Content="Run Query" />
            <Button x:Name="ClearResultsButton"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    MinWidth="140"
                    Padding="16,10"
                    Click="ClearResultsButton_OnClick"
                    Content="Clear Results" />

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Max Items" />
                <TextBox x:Name="MaxItemsTextBox"
                         Width="60"
                         Padding="10,6"
                         Text="100" />
            </StackPanel>

            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       Foreground="#FF334155"
                       Text="{Binding StatusMessage}" />

            <ProgressBar Grid.Column="5"
                         Height="18"
                         VerticalAlignment="Center"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Query Results" Padding="8">
                <DataGrid ItemsSource="{Binding Results}"
                          SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="60" />
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="220" />
                        <DataGridTextColumn Header="Preview" Binding="{Binding Preview}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#FFE5E7EB" />

            <GroupBox Grid.Column="2" Header="Selected Row JSON" Padding="8">
                <TextBox Text="{Binding SelectedDocumentJson, Mode=OneWay}"
                         FontFamily="Consolas"
                         FontSize="13"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>
    </Grid>
</Window>
