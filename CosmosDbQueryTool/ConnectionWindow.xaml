<Window x:Class="CosmosDbQueryTool.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Connections"
        Width="1120"
        Height="740"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16"
                Background="#FF0F172A"
                CornerRadius="8">
            <DockPanel>
                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="Connection Profiles" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#FFE2E8F0"
                               Text="The selected tab is the active connection used by the main window. Switch tabs here to change the current connection." />
                </StackPanel>

                <Button x:Name="AddConnectionButton"
                        DockPanel.Dock="Right"
                        MinWidth="150"
                        Padding="14,8"
                        Click="AddConnectionButton_OnClick"
                        Content="+ New Connection" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,14,0,14"
                Padding="16"
                BorderBrush="#FFD1D5DB"
                BorderThickness="1"
                CornerRadius="8">
            <TabControl ItemsSource="{Binding ConnectionTabs}"
                        SelectedItem="{Binding SelectedConnectionTab, Mode=TwoWay}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="0,0,12,12"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Connection Name" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     Margin="0,0,0,12"
                                     Padding="10,6"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,12,12"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Endpoint" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     Margin="0,0,0,12"
                                     Padding="10,6"
                                     Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Example: https://your-account.documents.azure.com:443/" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,0,12,12"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Primary Key" />
                            <PasswordBox Grid.Row="2"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="3"
                                         Margin="0,0,0,12"
                                         Padding="10,6"
                                         Loaded="ConnectionPasswordBox_OnLoaded"
                                         PasswordChanged="ConnectionPasswordBox_OnPasswordChanged"
                                         ToolTip="Cosmos DB account key" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Margin="0,0,12,12"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Database" />
                            <TextBox Grid.Row="3"
                                     Grid.Column="1"
                                     Margin="0,0,16,12"
                                     Padding="10,6"
                                     Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="2"
                                       Margin="0,0,5,12"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Container" />
                            <TextBox Grid.Row="3"
                                     Grid.Column="3"
                                     Margin="0,0,0,12"
                                     Padding="10,6"
                                     Text="{Binding ContainerName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="4"
                                       Foreground="#FF64748B"
                                       Text="Tip: the main window uses whichever tab is selected here. Use the tab strip to switch the active connection." />
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Border>

        <DockPanel Grid.Row="2">
            <TextBlock VerticalAlignment="Center"
                       Foreground="#FF64748B"
                       Text="The current connection is saved automatically when a query succeeds, and the selected tab is restored when the app starts." />
            <Button DockPanel.Dock="Right"
                    MinWidth="110"
                    Padding="14,8"
                    Click="CloseButton_OnClick"
                    Content="Close" />
        </DockPanel>
    </Grid>
</Window>

